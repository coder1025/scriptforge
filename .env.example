# Copy to .env for Docker Compose. Never commit your real .env.
# DEMO exercises the actual Java runtime with a deterministic model fixture.
SCRIPT_FORGE_MODE=DEMO
PORT=8080
READ_ONLY=false
# Set native only behind a trusted reverse proxy that supplies forwarded headers.
SERVER_FORWARD_HEADERS_STRATEGY=none

# MODEL uses an OpenAI-compatible Chat Completions endpoint with tool calling.
# The model must support tool_choice=required and parallel_tool_calls=false.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4096
AGENT_INPUT_BUDGET=24000

# Required for MODEL when server binds to a non-loopback address (including Docker).
# Set a long random token, then enter it in the local UI's access-token field.
# Never put the token in a GitHub Pages build or a public URL.
ADMIN_TOKEN=

